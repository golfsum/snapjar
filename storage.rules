rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /events/{code}/{fileName} {
      allow read: if true;

      // Photos are available on every plan. Videos are paid-only. Party
      // accepts files up to 100 MB; Pro accepts files up to 300 MB. Duration
      // (1 minute Party / 5 minutes Pro) is validated in the web client before
      // upload, while these server rules provide the hard storage backstop.
      allow create: if request.auth != null
        && firestore.exists(/databases/(default)/documents/events/$(code))
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (
            request.resource.contentType.matches('video/.*')
            && firestore.get(/databases/(default)/documents/events/$(code)).data.paid == true
            && (
              (
                firestore.get(/databases/(default)/documents/events/$(code)).data.pro == true
                && request.resource.size < 300 * 1024 * 1024
              )
              || (
                firestore.get(/databases/(default)/documents/events/$(code)).data.pro != true
                && request.resource.size < 100 * 1024 * 1024
              )
            )
          )
        );

      allow update: if false;

      // Admin can always clean up files. Album hosts can also delete files
      // from albums they own, which keeps Storage aligned with Firestore when
      // they remove photos from the gallery.
      allow delete: if request.auth != null && (
        (
          request.auth.token.email == 'nd82soft@gmail.com'
          && request.auth.token.email_verified == true
        )
        || (
          firestore.exists(/databases/(default)/documents/events/$(code))
          && firestore.get(/databases/(default)/documents/events/$(code)).data.hostUid == request.auth.uid
        )
      );
    }
  }
}
